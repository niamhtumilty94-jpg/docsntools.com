# Canonical site URL for SEO, sitemap, and Open Graph
VITE_SITE_URL=https://docsntools.com

# Optional: overrides the GA4 property. The site's own Measurement ID is
# committed as the default in src/lib/analytics.ts, so this only needs setting
# to point a build at a different property - or to "" to disable analytics.
# Consent Mode defaults to denied, so GA4 runs cookieless until consent is granted.
# VITE_GA4_MEASUREMENT_ID=

# Optional: Umami analytics (both required to enable)
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
